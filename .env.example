# Notion internal integration token.
# Create one at https://www.notion.so/my-integrations (type: Internal), then
# share the "Health Tracker" page with it so it inherits access to all four DBs.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs — already filled in for Faisal's workspace.
NOTION_ROUTINES_DB=71118190-7086-43f5-80b1-a13fdb3840fd
NOTION_EXERCISES_DB=a5288f02-c641-439f-8bc6-b4a82b504504
NOTION_LOG_DB=3570c782-4a59-8141-8842-fce74812fd2e

# Optional: lock the app behind a passcode — recommended once it's deployed,
# because the URL is otherwise open to anyone who finds it. Use more than a
# 4-digit PIN.
# APP_PASSCODE=
# Optional: key for the passcode cookie. Defaults to NOTION_TOKEN.
# APP_SECRET=

# Optional: training database ids. Leave unset and the app finds (or, on first
# setup, creates) "Training Programme", "Programme Exercises" and "Lift Log" on
# the page that holds the Workout Log.
# NOTION_PROGRAMME_DB=
# NOTION_PROGRAMME_EXERCISES_DB=
# NOTION_LIFT_LOG_DB=
